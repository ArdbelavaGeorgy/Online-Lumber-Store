43b\u0438\u044f\u0435\u0442 \u043d\u0430 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0435\u0435 \u0432\u043b\u0430\u0436\u043d\u043e\u0441\u0442\u0438. \u041e\u043d\u0430 \u0438\u043c\u0435\u0435\u0442 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e \u0443\u0441\u044b\u0445\u0430\u0442\u044c \u043e\u0442 \u043f\u043e\u0442\u0435\u0440\u0438 \u0432\u043b\u0430\u0433\u0438 \u0438 \u043d\u0430\u043f\u0440\u043e\u0442\u0438\u0432, \u043d\u0430\u0431\u0443\u0445\u0430\u0442\u044c \u043e\u0442 \u043f\u0435\u0440\u0435\u0443\u0432\u043b\u0430\u0436\u043d\u0435\u043d\u0438\u044f \u043f\u0440\u0438 \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u044f\u0445 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0432\u043b\u0430\u0436\u043d\u043e\u0441\u0442\u0438 \u0432\u043e\u0437\u0434\u0443\u0445\u0430.<\/p>\n<p>\u0422\u0430\u043a\u043e\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043d\u044b \u043d\u0435\u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u043e \u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430 \u0434\u043e\u043b\u0433\u043e\u0432\u0435\u0447\u043d\u043e\u0441\u0442\u0438 \u0434\u0440\u0435\u0432\u0435\u0441\u043d\u043e\u0433\u043e \u0438\u0437\u0434\u0435\u043b\u0438\u044f, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0432\u0430\u0436\u043d\u043e \u043f\u0435\u0440\u0435\u0434 \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0430 \u043f\u043e\u0432\u044b\u0441\u0438\u0442\u044c \u0435\u0433\u043e \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u0438 \u043a \u0432\u043b\u0430\u0433\u043e\u043f\u043e\u0433\u043b\u043e\u0449\u0435\u043d\u0438\u044e. \u041a\u0440\u043e\u043c\u0435 \u0442\u043e\u0433\u043e \u0432\u0430\u0436\u043d\u043e \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044c \u0434\u0435\u0440\u0435\u0432\u043e \u043e\u0442 \u043d\u0435\u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u043e\u0433\u043e \u0432\u043b\u0438\u044f\u043d\u0438\u044f \u043f\u043b\u0435\u0441\u0435\u043d\u0438, \u0433\u0440\u0438\u0431\u043a\u043e\u0432, \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439, \u043f\u043e\u0432\u044b\u0441\u0438\u0442\u044c \u0435\u0433\u043e \u043f\u043e\u0436\u0430\u0440\u043e\u0441\u0442\u043e\u0439\u043a\u043e\u0441\u0442\u044c, \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u0438 \u043a \u0443\u043b\u044c\u0442\u0440\u0430\u0444\u0438\u043e\u043b\u0435\u0442\u043e\u0432\u043e\u043c\u0443 \u0438\u0437\u043b\u0443\u0447\u0435\u043d\u0438\u044e, \u043d\u0430\u0441\u0435\u043a\u043e\u043c\u044b\u043c.<br \/>\n\t\t\n<style>\n#text-1281264193 {\n  font-size: 0.9rem;\n}\n@media (min-width:550px) {\n  #text-1281264193 {\n    font-size: 1rem;\n  }\n}\n<\/style>\n\t<\/div>\n\t\n\t\t<\/div>\n\t<\/div>\n\t\n\t<div id=\"accordion-3414330346\" class=\"accordion-item\">\n\t\t<a id=\"accordion-3414330346-label\" class=\"accordion-title plain\" href=\"#accordion-item-\u0410\u043d\u0442\u0438\u0441\u0435\u043f\u0442\u0438\u043a\u0438_\u0434\u043b\u044f_\u0434\u0435\u0440\u0435\u0432\u0430_\u2013_\u0447\u0442\u043e_\u044d\u0442\u043e?\" aria-expanded=\"false\" aria-controls=\"accordion-3414330346-content\" >\n\t\t\t<button class=\"toggle\" aria-label=\"Toggle\"><i class=\"icon-angle-down\"><\/i><\/button>\n\t\t\t<span>\u0410\u043d\u0442\u0438\u0441\u0435\u043f\u0442\u0438\u043a\u0438 \u0434\u043b\u044f \u0434\u0435\u0440\u0435\u0432\u0430 \u2013 \u0447\u0442\u043e \u044d\u0442\u043e?<\/span>\n\t\t<\/a>\n\t\t<div id=\"accordion-3414330346-content\" class=\"accordion-inner\" aria-labelledby=\"accordion-3414330346-label\" >\n\t\t\t\n\t<div id=\"text-1920124183\" class=\"text\">\n\t\t\n<p>\u0410\u043d\u0442\u0438\u0441\u0435\u043f\u0442\u0438\u043a\u0438 \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f \u043a \u0437\u0430\u0449\u0438\u0442\u043d\u044b\u043c \u0441\u043e\u0441\u0442\u0430\u0432\u0430\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0442\u043e\u043a\u0441\u0438\u0447\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0434\u0435\u0440\u0435\u0432\u043e\u0440\u0430\u0437\u0440\u0443\u0448\u0430\u044e\u0449\u0438\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430, \u0432 \u0447\u0438\u0441\u043b\u0435 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043d\u0430\u0441\u0435\u043a\u043e\u043c\u044b\u0435, \u043c\u0438\u043a\u0440\u043e\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u044b, \u0433\u0440\u0438\u0431\u043a\u0438. \u0414\u0430\u043d\u043d\u044b\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430 \u043c\u043e\u0433\u0443\u0442 \u0432\u0445\u043e\u0434\u0438\u0442\u044c \u0432 \u0441\u043e\u0441\u0442\u0430\u0432 \u0444\u0438\u043d\u0438\u0448\u043d\u044b\u0445 \u0438 \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0442\u0438\u043f\u043e\u0432 \u043f\u043e\u043a\u0440\u044b\u0442\u0438\u0439, \u0430 \u0438\u0437\u0433\u043e\u0442\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0442 \u0438\u0445 \u043d\u0430 \u0430\u043b\u043a\u0438\u0434\u043d\u043e\u0439 \u043b\u0438\u0431\u043e \u0432\u043e\u0434\u043d\u043e\u0439 \u043e\u0441\u043d\u043e\u0432\u0435.<\/p>\n<p>\u0412\u043e\u0434\u043d\u044b\u0435 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u044b \u043e\u0442\u043b\u0438\u0447\u0430\u044e\u0442\u0441\u044f \u044d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0447\u0438\u0441\u0442\u043e\u0442\u043e\u0439, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\u043c \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u0430\u0445\u0430 \u0438 \u0431\u044b\u0441\u0442\u0440\u044b\u043c \u0432\u044b\u0441\u044b\u0445\u0430\u043d\u0438\u0435\u043c. \u0411\u043e\u043b\u0435\u0435 \u0442\u043e\u0433\u043e \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0432\u043e\u0434\u043d\u043e\u0439 \u043e\u0441\u043d\u043e\u0432\u0435 \u0441\u043e\u0437\u0434\u0430\u0435\u0442\u0441\u044f \u0437\u0430\u0449\u0438\u0442\u043d\u044b\u0439 \u0441\u043b\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u044e \u0438\u0437\u043b\u0438\u0448\u043a\u043e\u0432 \u0432\u043b\u0430\u0433\u0438 \u0441 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u0438 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0435\u0435 \u0432\u043f\u0438\u0442\u044b\u0432\u0430\u043d\u0438\u044e. \u0422\u0430\u043a\u0430\u044f \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0437\u0430\u0449\u0438\u0442\u043d\u043e\u0433\u043e \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0435\u0433\u043e \u0434\u0430\u0436\u0435 \u0434\u043b\u044f \u0432\u043b\u0430\u0436\u043d\u044b\u0445 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0435\u0439.<br \/>\n\t\t\n<style>\n#text-1920124183 {\n  font-size: 0.9rem;\n}\n@media (min-width:550px) {\n  #text-1920124183 {\n    font-size: 1rem;\n  }\n}\n<\/style>\n\t<\/div>\n\t\n\t\t<\/div>\n\t<\/div>\n\t\n\t<div id=\"accordion-3518525903\" class=\"accordion-item\">\n\t\t<a id=\"accordion-3518525903-label\" class=\"accordion-title plain\" href=\"#accordion-item-\u041a\u0430\u043a\u0438\u0435_\u0434\u0440\u0435\u0432\u0435\u0441\u043d\u044b\u0435_\u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044b_\u0432\u043e\u0434\u043e\u0441\u0442\u043e\u0439\u043a\u0438?\" aria-expanded=\"false\" aria-controls=\"accordion-35185259